# =============================================================================
# 环境变量模板
# -----------------------------------------------------------------------------
# 复制为 .env 用于本地 Docker 部署；真实密钥不得提交进 Git，本文件不含任何凭据。
# 职责边界：.env 只管端口、连接、密钥与引导；业务模式、Token TTL、模型选择、
#          流式/排序/检索开关等业务配置一律在 Nacos（nacos/*.yaml）。
# 说明：Compose 容器内的基础设施地址已固定为容器服务名（mysql/redis/minio 等），
#      本文件中的 HOST/PORT 类变量主要供宿主机预检脚本（scripts/）与非容器运行使用。
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Nacos 注册与配置中心
# -----------------------------------------------------------------------------
# Nacos API 走 8848；18080 是容器内 Nacos 3.x 控制台端口。
NACOS_SERVER=127.0.0.1:8848
NACOS_NAMESPACE=BK-AGENT
NACOS_USERNAME=bkagent
NACOS_PASSWORD=
# Optional app-client credentials, used only when NACOS_AUTH_ENABLE=true.
NACOS_CLIENT_USERNAME=
NACOS_CLIENT_PASSWORD=
# Nacos 服务端鉴权（容器初始化用；未开启服务端鉴权时留空）。
NACOS_AUTH_TOKEN=
NACOS_AUTH_IDENTITY_KEY=
NACOS_AUTH_IDENTITY_VALUE=
# A2A AgentCard 的 Nacos 注册开关（默认关闭，由 Compose 传入服务容器）。
NACOS_A2A_AGENT_REGISTRY_ENABLED=false

# -----------------------------------------------------------------------------
# 2. 宿主机端口发布（默认绑定 localhost，改 HOST_BIND_ADDRESS 可对外暴露）
# -----------------------------------------------------------------------------
HOST_BIND_ADDRESS=127.0.0.1
NACOS_EXPOSED_PORT=8848
NACOS_CONSOLE_EXPOSED_PORT=18080
NACOS_GRPC_EXPOSED_PORT=9848
NACOS_GRPC_TLS_EXPOSED_PORT=9849
AUTH_EXPOSED_PORT=9101
GATEWAY_EXPOSED_PORT=5010
REDIS_EXPOSED_PORT=6379
ROCKETMQ_NAMESRV_EXPOSED_PORT=9876
ROCKETMQ_BROKER_EXPOSED_PORT=10911
ROCKETMQ_BROKER_VIP_EXPOSED_PORT=10909
MINIO_EXPOSED_PORT=19000
MINIO_CONSOLE_EXPOSED_PORT=19001
ELASTICSEARCH_EXPOSED_PORT=9200
MILVUS_EXPOSED_PORT=19530
MILVUS_HEALTH_EXPOSED_PORT=9091
MILVUS_ETCD_EXPOSED_PORT=2379

# -----------------------------------------------------------------------------
# 3. MySQL 主库
# -----------------------------------------------------------------------------
# root 密码必须显式提供，无可用默认值。
MYSQL_ROOT_PASSWORD=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_PARAMS=useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai

# -----------------------------------------------------------------------------
# 4. MySQL MCP 服务（可选，profile: mcp）
# 两个密钥都必须设置后才能启动 mysql-mcp；无默认凭据。
# -----------------------------------------------------------------------------
MYSQL_MCP_PASSWORD=
MYSQL_MCP_TOKEN=
MYSQL_MCP_BIND_ADDRESS=127.0.0.1
MYSQL_MCP_EXPOSED_PORT=18081
MYSQL_MCP_DATABASES=bk_auth,bk_listing,bk_customer,bk_notification,bk_marketing,bk_promotion,bk_business,bk_agent,bk_memory,bk_contract,bk_settlement,bk_interview
MYSQL_MCP_MAX_ROWS=200
MYSQL_MCP_QUERY_TIMEOUT_MS=5000
MYSQL_MCP_ALLOWED_HOSTS=127.0.0.1:*,localhost:*,mysql-mcp:8000

# -----------------------------------------------------------------------------
# 5. 中间件连接（宿主机预检/非容器运行用；容器内由 Compose 固定指向容器服务名）
# -----------------------------------------------------------------------------
# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# Dedicated authorization Redis transport inside Compose. The normal business
# Redis connection remains on 6379; Auth/Agent use TLS on 6380.
AUTHZ_REDIS_HOST=redis
AUTHZ_REDIS_PORT=6380
REDIS_TLS_EXPOSED_PORT=6380
REDIS_TLS_CA_CERT=.secrets/redis/tls/ca.crt
# Provisioning-only Redis ACL operator; keep both values in ignored .env/secret storage.
REDIS_ADMIN_USER=authz-acl-admin
REDIS_ADMIN_PASSWORD=
# RocketMQ
ROCKETMQ_NAME_SERVER=127.0.0.1:9876
ROCKETMQ_NAMESRV_HOST=127.0.0.1
ROCKETMQ_NAMESRV_PORT=9876
# MinIO 对象存储
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_HOST=127.0.0.1
MINIO_PORT=19000
MINIO_ENDPOINT=http://127.0.0.1:19000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_PUBLIC_BASE_URL=http://127.0.0.1:19000
MINIO_BUCKET=generated-assets
# Elasticsearch
ES_HOST=127.0.0.1
ES_PORT=9200
# marketing-content-service 业务 ES 地址（容器内默认指向 compose 的 elasticsearch 服务）
MARKETING_ELASTICSEARCH_URIS=http://elasticsearch:9200
# Milvus 向量库（MILVUS_HOST/PORT 供预检脚本使用）
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
# Milvus 内部 etcd/MinIO（与业务 MinIO 相互独立）
MILVUS_MINIO_ROOT_USER=
MILVUS_MINIO_ROOT_PASSWORD=

# -----------------------------------------------------------------------------
# 6. 模型网关与安全密钥（真实认证/AI 调用必填）
# -----------------------------------------------------------------------------
AUTH_TOKEN_SECRET=
# chat 通道（deepseek starter，各服务经 Nacos 模板引用）：
# 网关地址可配置，默认指向 KE 网关（Bella OpenAI 兼容）；
# 密钥优先级 DEEPSEEK_API_KEY > KE_API_KEY，两者取其一即可。
DEEPSEEK_BASE_URL=https://open-chatgpt.ke.com/v1
DEEPSEEK_API_KEY=
KE_API_KEY=
# 合同 OCR（同一 KE 网关 · 百度通用文字识别）。
KE_OCR_BASE_URL=https://open-chatgpt.ke.com/v1
KE_OCR_MODEL=baidu-general
# 房源图片生成（同一 KE 网关 · 豆包 Seedream）。
KE_IMAGE_BASE_URL=https://open-chatgpt.ke.com/v1
KE_IMAGE_MODEL=doubao-seedream-4.5-gen
# embedding 与 rerank 已收口到 rag-service，见下方第 7 组。

# -----------------------------------------------------------------------------
# 7. RAG 独立连接与密钥（仅连接/密钥引导；角色、worker 与打分策略在 Nacos）
# -----------------------------------------------------------------------------
# rag-service 治理面暴露端口
RAG_MANAGEMENT_EXPOSED_PORT=9018
# RAG 专用库与 memory 库（其余业务库名在 Compose 内固定）
RAG_MYSQL_USER=rag_runtime
RAG_MYSQL_PASSWORD=
MYSQL_DB_RAG=bk_rag
MYSQL_DB_MEMORY=bk_memory
MYSQL_DB_BUSINESS_REVIEW=bk_business_review
# 检索基础设施
RAG_ELASTICSEARCH_URIS=http://elasticsearch:9200
RAG_MILVUS_HOST=milvus
RAG_MILVUS_PORT=19530
RAG_MILVUS_TOKEN=
RAG_MILVUS_SECURE=false
# embedding 通道（OpenAI 兼容）
RAG_EMBEDDING_BASE_URL=https://open-chatgpt.ke.com/v1
RAG_EMBEDDING_MODEL=baai-m3-1b-base-v1-embedding-20240619
RAG_EMBEDDING_API_KEY=
# RAG 出站 HTTP 白名单：ES、embedding 网关、reranker 等（逗号分隔）
RAG_HTTP_ALLOWED_HOSTS=elasticsearch,host.docker.internal,open-chatgpt.ke.com,bkanent-reranker-dev
# reranker：bkanent-rerank-dev 专用 Docker 网络上的外部 Reranker-BGE-V2-M3 项目，
# 走治理协议并钉扎模型身份（revision/摘要漂移即拒绝）。
RAG_RERANK_ENDPOINT=http://bkanent-reranker-dev:18111/api/v1/rerank
RAG_RERANK_MODEL=bge-reranker-v2-m3-v1
RAG_RERANK_PROTOCOL=governed
RAG_RERANK_EXPECTED_REVISION=324cc40576b08b305b9c65a867c26c173a477ae2
RAG_RERANK_EXPECTED_ARTIFACT_DIGEST=76cd4a977b9001bf8e28e41bac6ce53b2d334d0c567f6928a9b88655bafc833f
RAG_RERANK_API_KEY=
# RAG 与 Memory 之间的候选许可专用 RPC 密钥；与通用 Memory RAG 密钥分离。
RAG_MEMORY_CANDIDATE_KEY_ID=rag-memory-candidate-current
RAG_MEMORY_CANDIDATE_KEY_SECRET=
# 本机受控验收探针使用的短时 bearer token；不要提交真实值。
RAG_PROBE_ACCESS_TOKEN=
# Memory v2 领域投影与检索默认关闭；完成本地空间准备后再显式启用。
MEMORY_V2_SHARING_ENABLED=false
MEMORY_V2_SHARING_MAX_EXPORT_UTF8_BYTES=24576
MEMORY_RAG_DOMAIN_PROJECTION_ENABLED=false
MEMORY_RAG_DOMAIN_SEARCH_ENABLED=false
MEMORY_RAG_DISPATCHER_ENABLED=false
# memory 消费端独立受管语义版本注册（LR-43），默认空：所有语义候选失败关闭。
# 部署 agent 须核对当前已 verified profile/实际响应，再显式填入确切 scoringVersion；
# 当前三空间 governed/LOGIT profile 的确切值（不是自动默认，也不是 runtime 验收证据）：
# 12ab2575eb91fb134ec2d616b872f37578457fe88258ce2906609bcdc63db88b
# 多个已验证版本可逗号分隔；禁止通配/accept-all，升级时同步核对响应钉扎及空间 profile。
MEMORY_RAG_SEMANTIC_SCORING_VERSIONS=
# rag-service 调用 auth 的请求签名密钥
RAG_AUTH_RPC_SECRET=

# -----------------------------------------------------------------------------
# 8. 领域间 RPC 密钥
# -----------------------------------------------------------------------------
LISTING_RAG_RPC_SECRET=
MEMORY_RAG_RPC_SECRET=
AGENT_RAG_RPC_SECRET=
# A2A/RPC 响应签名使用独立的 AUTH_RAG_RPC_RESPONSE 密钥（域分离签名，不与上面混用）。
AUTH_RAG_RPC_RESPONSE_KEY_ID=auth-current
AUTH_RAG_RPC_RESPONSE_SECRET=

# -----------------------------------------------------------------------------
# 9. 跨域只读密钥与 A2A 请求签名密钥
# -----------------------------------------------------------------------------
# 独立只读密钥；绝不复用领域 RAG 签名密钥。
CUSTOMER_LISTING_READ_SECRET=
MARKETING_LISTING_READ_SECRET=
# A2A/Auth 与 Memory v2 共用每服务一组 Ed25519 身份，但使用不同协议签名域。
# Supervisor 和所有官方 A2A Agent 的核心 Memory 读取、授权核验与归档为必需接入，没有启用或旁路开关；下列 false 只控制可选压缩/经验加工。
# 在仓库根目录运行 scripts/security/New-ServiceIdentities.ps1 生成本机密钥，
# 私钥保存在 Git 忽略的 .secrets/service-identities/<service>/private-key.pem，
# Compose 只读挂载到所属服务；public-keys.env 仅含公钥并由 verifier 加载。
# 新服务只需生成一对身份，并将公钥登记到它实际调用的 verifier；不要在这里配置私钥。
# Auth 响应公钥的 key ID；须与 Auth 本机身份目录/验证方登记保持一致。
AUTH_SERVICE_IDENTITY_KEY_ID=auth-service-current
# 新版本化授权链默认关闭；启用前需完成服务身份、Redis ACL、权限映射和部署验收。
AUTH_AUTHORIZATION_ENABLED=false
AGENT_AUTHORIZATION_ENABLED=false
BUSINESS_REVIEW_AUTHORIZATION_ENABLED=true
BUSINESS_REVIEW_A2A_AUTHORIZATION_ENABLED=true
AUTH_AUTHORIZATION_REDIS_ENABLED=false
AUTHZ_REDIS_WRITER_CONFIGURED=false
AUTHZ_REDIS_READER_CONFIGURED=false
MEMORY_V2_AUTHORIZATION_CONTEXT_ENABLED=true
# 专用授权版本 Redis ACL 凭据；writer/reader 分别使用 authz-writer 与 agent-authz-reader。
AUTHZ_REDIS_WRITER_PASSWORD=
AUTHZ_REDIS_READER_PASSWORD=
AUTHZ_REDIS_TLS=true
AGENT_MEMORY_V2_COMPRESSION_ENABLED=false
AGENT_MEMORY_V2_PREFERENCE_BUDGET_TOKENS=800
AGENT_MEMORY_V2_EXPERIENCE_BUDGET_TOKENS=512
LISTING_MEMORY_V2_COMPRESSION_ENABLED=false
MARKETING_MEMORY_V2_COMPRESSION_ENABLED=false
BUSINESS_MEMORY_V2_COMPRESSION_ENABLED=false
BUSINESS_REVIEW_MEMORY_V2_COMPRESSION_ENABLED=false
BUSINESS_REVIEW_AGENT_MODEL=gpt-5.6-terra
BUSINESS_REVIEW_SOURCE_MODE=http
BUSINESS_REVIEW_LISTING_BASE_URL=http://listing-master-service:9003
BUSINESS_REVIEW_KNOWLEDGE_BASE_URL=http://knowledge-service:9015
COMPARE_MEMORY_V2_COMPRESSION_ENABLED=false
CONTRACT_MEMORY_V2_COMPRESSION_ENABLED=false
SETTLEMENT_MEMORY_V2_COMPRESSION_ENABLED=false
NOTIFICATION_MEMORY_V2_COMPRESSION_ENABLED=false
MEDIA_MEMORY_V2_COMPRESSION_ENABLED=false
INTERVIEW_TICKET_SECRET=
INTERVIEW_MEMORY_V2_COMPRESSION_ENABLED=false

# The generator also writes these safe public-key values to .secrets/service-identities/public-keys.env.
# Compose loads that generated file; keep it out of this hand-maintained example.

# Experience learning is separate from required Memory read/archive; it stays closed until trusted outcomes are available.
MEMORY_V2_EXPERIENCE_ENABLED=false
MEMORY_V2_EXPERIENCE_PROCESSING_ENABLED=false
MEMORY_V2_EXPERIENCE_POLL_MS=5000
MEMORY_V2_EXPERIENCE_BATCH_SIZE=4
MEMORY_V2_EXPERIENCE_MAX_ATTEMPTS=4
MEMORY_V2_EXPERIENCE_LEASE_SECONDS=90
MEMORY_V2_EXPERIENCE_RETRY_SECONDS=30
MEMORY_V2_EXPERIENCE_MAX_CANDIDATES=128
MEMORY_V2_EXPERIENCE_MAX_TOKEN_BUDGET=2048
MEMORY_V2_EXPERIENCE_HALF_LIFE_DAYS=180
# Domain result events may seed experience assessment only after that domain's fixture is signed off.
MARKETING_MEMORY_EXPERIENCE_OUTCOME_PUBLISHER=false
INTERVIEW_MEMORY_EXPERIENCE_OUTCOME_PUBLISHER=false
LISTING_MEMORY_EXPERIENCE_OUTCOME_PUBLISHER=false
BUSINESS_MEMORY_EXPERIENCE_OUTCOME_PUBLISHER=false
CONTRACT_MEMORY_EXPERIENCE_OUTCOME_PUBLISHER=false
COMPARE_MEMORY_EXPERIENCE_OUTCOME_PUBLISHER=false
SETTLEMENT_MEMORY_EXPERIENCE_OUTCOME_PUBLISHER=false
MEMORY_V2_PREFERENCE_PROCESSING_ENABLED=false
MEMORY_V2_PREFERENCE_PROCESSING_MODE=SHADOW
MEMORY_V2_PREFERENCE_MODEL=
AGENT_MEMORY_V2_CACHE_ENTRIES=128
AGENT_MEMORY_V2_CACHE_BYTES=33554432
AGENT_MEMORY_V2_CACHE_TTL_MS=60000
AGENT_MEMORY_V2_SOFT_TOKENS=8000
AGENT_MEMORY_V2_HARD_TOKENS=12000
AGENT_MEMORY_V2_RECENT_MESSAGES=12
AGENT_MEMORY_V2_SUMMARY_TIMEOUT_MS=5000
AGENT_MEMORY_V2_CLEANUP_MS=30000
AGENT_MEMORY_V2_TOOL_INLINE_CHARS=4096
AGENT_MEMORY_V2_RECALL_CHARS=8192

# -----------------------------------------------------------------------------
# 10. Nacos 配置发布与运行引导
# -----------------------------------------------------------------------------
# Nacos 配置发布白名单：只写精确受影响的 data ID；留空表示拒绝发布。
NACOS_CONFIG_DATA_IDS=
# 运行模式（Compose 内已固定为 distributed，此处供非容器运行参考）。
SPRING_PROFILES_ACTIVE=distributed
SERVICE_READINESS_MODE=distributed
# A2A 对外基址（Compose 内各服务已固定为容器服务名 URL，此处供非容器/对外暴露场景）。
A2A_PUBLIC_BASE_URL=http://127.0.0.1:9002

# =============================================================================
# 尾注
# -----------------------------------------------------------------------------
# - 业务模式、Token TTL、模型选择、流式/排序/检索开关在 nacos/*.yaml 中维护。
# - Docker 开发模板保留本地集成（Redis/ES/Milvus 启用、RocketMQ 流式）。
# - 分布式生产：各 integration.mode 置 real，并在 Nacos 选择/连接已实现的
#   真实提供方（合同要求真实 OCR + esign）；业务覆盖不要加进 .env。
# - NACOS_USERNAME/NACOS_PASSWORD 与 MINIO_PUBLIC_BASE_URL 由 Compose 传入应用容器。
# - Nacos Admin 账号初始化、命名空间 Card 更新权限是独立的运维步骤。
# =============================================================================
