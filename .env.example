# Copy this file to .env for local Docker deployment.
# Keep real values outside Git; this file intentionally contains no credentials.
# .env owns ports, connections, secrets and bootstrap only; business config lives in Nacos.
# Host-side infrastructure addresses remain available for existing preflight/start tools.

# Nacos API uses 8848; 8080 is the Nacos 3.x console port inside the container.
NACOS_SERVER=127.0.0.1:8848
NACOS_NAMESPACE=
NACOS_USERNAME=nacos
NACOS_PASSWORD=

# Docker host port overrides. Published ports bind to localhost by default.
HOST_BIND_ADDRESS=127.0.0.1
MYSQL_EXPOSED_PORT=3306
NACOS_EXPOSED_PORT=8848
NACOS_CONSOLE_EXPOSED_PORT=18080
NACOS_GRPC_EXPOSED_PORT=9848
NACOS_GRPC_TLS_EXPOSED_PORT=9849
AUTH_EXPOSED_PORT=9101
GATEWAY_EXPOSED_PORT=5010
REDIS_EXPOSED_PORT=6379
ROCKETMQ_NAMESRV_EXPOSED_PORT=9876
ROCKETMQ_BROKER_EXPOSED_PORT=10911
ROCKETMQ_BROKER_VIP_EXPOSED_PORT=10909
MINIO_EXPOSED_PORT=19000
MINIO_CONSOLE_EXPOSED_PORT=19001
ELASTICSEARCH_EXPOSED_PORT=9200
MILVUS_EXPOSED_PORT=19530
MILVUS_HEALTH_EXPOSED_PORT=9091
MILVUS_ETCD_EXPOSED_PORT=2379

# Database. Docker uses bk_dev_password when MYSQL_ROOT_PASSWORD is blank.
MYSQL_ROOT_PASSWORD=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_PARAMS=useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai

# Optional independent, read-only MySQL MCP service (profile: mcp).
# Both secrets must be set before starting mysql-mcp; no default credentials.
MYSQL_MCP_PASSWORD=
MYSQL_MCP_TOKEN=
MYSQL_MCP_BIND_ADDRESS=127.0.0.1
MYSQL_MCP_EXPOSED_PORT=18081
MYSQL_MCP_DATABASES=bk_auth,bk_listing,bk_customer,bk_notification,bk_marketing,bk_promotion,bk_business,bk_agent,bk_memory,bk_contract,bk_settlement,bk_interview
MYSQL_MCP_MAX_ROWS=200
MYSQL_MCP_QUERY_TIMEOUT_MS=5000
MYSQL_MCP_ALLOWED_HOSTS=127.0.0.1:*,localhost:*,mysql-mcp:8000

# Optional infrastructure used by the full profile.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
ROCKETMQ_NAME_SERVER=127.0.0.1:9876
ROCKETMQ_NAMESRV_HOST=127.0.0.1
ROCKETMQ_NAMESRV_PORT=9876
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_HOST=127.0.0.1
MINIO_PORT=19000
MINIO_ENDPOINT=http://127.0.0.1:19000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_PUBLIC_BASE_URL=http://127.0.0.1:19000
MINIO_BUCKET=generated-assets
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
MILVUS_ENDPOINT=http://127.0.0.1:19530
MILVUS_TOKEN=
MILVUS_USERNAME=
MILVUS_PASSWORD=
ELASTICSEARCH_URIS=http://127.0.0.1:9200
ES_HOST=127.0.0.1
ES_PORT=9200
MILVUS_MINIO_ROOT_USER=
MILVUS_MINIO_ROOT_PASSWORD=

# Security and model credentials. Required for real authentication/AI calls.
AUTH_TOKEN_SECRET=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
AGENT_RAG_RERANK_API_KEY=

# Distributed bootstrap defaults (not business configuration).
SPRING_PROFILES_ACTIVE=distributed
SERVICE_READINESS_MODE=distributed
A2A_PUBLIC_BASE_URL=http://127.0.0.1:9002

# Business modes, token TTLs, models, stream/ranking/search switches live in nacos/*.yaml.
# Docker development templates retain local integrations, Redis/ES/Milvus enabled and RocketMQ streaming.
# Distributed production: set each integration.mode to real AND select/connect implemented real
# providers in Nacos (contract requires real OCR + esign); do not add business overrides to .env.
# NACOS_USERNAME/PASSWORD and MINIO_PUBLIC_BASE_URL are passed to application containers by Compose.
# Nacos Admin account initialization and namespace Card-update permissions are separate setup steps.
