{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Studio V2 public contract definitions",
  "description": "Implemented common envelope fields; supported content shapes are documented in studio-v2-api.md. Definitions are an integration contract, not evidence of runtime validation.",
  "$defs": {
    "id": {"type":"string","minLength":1,"maxLength":128},
    "money": {"type":"object","required":["amount","currency"],"properties":{"amount":{"type":"string","pattern":"^[0-9]+(?:\\.[0-9]+)?$"},"currency":{"const":"CNY"}},"additionalProperties":false},
    "artifactRef": {"type":"object","required":["seriesId","version"],"properties":{"seriesId":{"$ref":"#/$defs/id"},"revisionId":{"$ref":"#/$defs/id"},"version":{"type":"integer","minimum":1}}},
    "listingSourceRef": {"type":"object","required":["sourceSystem","sourceId","sourceRevision","contentHash","dataMode"],"properties":{"sourceSystem":{"type":"string","minLength":1,"maxLength":64},"sourceId":{"$ref":"#/$defs/id"},"sourceRevision":{"type":"string","minLength":1,"maxLength":255},"contentHash":{"type":"string","pattern":"^[0-9a-f]{64}$"},"dataMode":{"enum":["REAL","SIMULATED","MIXED","UNKNOWN"]}},"additionalProperties":false},
    "sourceRef": {"type":"object","required":["type","id"],"properties":{"type":{"type":"string"},"id":{"$ref":"#/$defs/id"},"label":{"type":"string"},"sourceSystem":{"type":"string","maxLength":64},"sourceRevision":{"type":"string","maxLength":255},"contentHash":{"type":"string","pattern":"^[0-9a-f]{64}$"},"dataMode":{"enum":["REAL","SIMULATED","MIXED","UNKNOWN"]},"fields":{"type":"array","items":{"type":"string"}}}},
    "context": {"type":"object","required":["refs","criteria"],"properties":{"refs":{"type":"array","maxItems":100,"items":{"$ref":"#/$defs/sourceRef"}},"criteria":{"type":"object","properties":{"region":{"type":["string","null"]},"areaCode":{"type":["string","null"]},"budget":{"oneOf":[{"$ref":"#/$defs/money"},{"type":"null"}]},"bedrooms":{"type":["integer","null"],"minimum":0,"maximum":30},"platform":{"type":["string","null"]},"period":{"type":["string","null"]},"scopeLabel":{"type":["string","null"]},"requirements":{"type":["string","null"]}},"additionalProperties":false}},"additionalProperties":false},
    "command": {"type":"object","required":["requestId","actionId","expectedContextRevision","input"],"properties":{"requestId":{"$ref":"#/$defs/id"},"actionId":{"type":"string","maxLength":160},"expectedContextRevision":{"type":"integer","minimum":1},"input":{"type":"object"},"artifactRefs":{"type":"array","items":{"$ref":"#/$defs/artifactRef"}}}},
    "listingComparisonInput": {"type":"object","required":["listingRefs"],"properties":{"listingRefs":{"type":"array","minItems":2,"maxItems":6,"uniqueItems":true,"items":{"$ref":"#/$defs/listingSourceRef"}}},"additionalProperties":false},
    "receipt": {"type":"object","required":["requestId","workId","status"],"properties":{"requestId":{"$ref":"#/$defs/id"},"workId":{"$ref":"#/$defs/id"},"status":{"type":"string"},"artifactRefs":{"type":"array","items":{"$ref":"#/$defs/artifactRef"}},"run":{"type":"object"},"message":{"type":"string"}}},
    "artifact": {"type":"object","required":["seriesId","revisionId","version","workId","type","schemaVersion","title","content","contextRevision","sourceRefs","actions","freshness"],"properties":{"seriesId":{"$ref":"#/$defs/id"},"revisionId":{"$ref":"#/$defs/id"},"version":{"type":"integer","minimum":1},"workId":{"$ref":"#/$defs/id"},"sourceArtifactId":{"type":["string","null"]},"taskId":{"type":["string","null"]},"type":{"type":"string"},"schemaVersion":{"const":"1.0"},"title":{"type":"string"},"content":{"type":"object"},"contextRevision":{"type":"integer","minimum":1},"sourceRefs":{"type":"array","items":{"$ref":"#/$defs/sourceRef"}},"actions":{"type":"array","items":{"type":"object","required":["actionId","kind","label","availability"]}},"freshness":{"type":"object","required":["status","reasons"],"properties":{"status":{"enum":["CURRENT","STALE","UNKNOWN"]},"reasons":{"type":"array","items":{"type":"string"}}}},"createdAt":{"type":"string","format":"date-time"}}},
    "draftRevision": {"type":"object","required":["requestId","expectedVersion"],"properties":{"requestId":{"$ref":"#/$defs/id"},"expectedVersion":{"type":"integer","minimum":1},"content":{"type":"object","properties":{"body":{"type":"string","maxLength":100000},"headline":{"type":"string","maxLength":500}}},"derivedFromVersion":{"type":"integer","minimum":1},"note":{"type":"string","maxLength":500}},"anyOf":[{"required":["derivedFromVersion"]},{"required":["content"],"properties":{"content":{"required":["body"]}}}]}
  }
}
