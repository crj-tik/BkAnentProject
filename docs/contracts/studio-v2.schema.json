{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Studio V2 public contract definitions",
  "description": "Implemented common envelope fields; supported content shapes are documented in studio-v2-api.md. Definitions are an integration contract, not evidence of runtime validation.",
  "$defs": {
    "id": {"type":"string","minLength":1,"maxLength":128},
    "money": {"type":"object","required":["amount","currency"],"properties":{"amount":{"type":"string","minLength":1,"maxLength":32,"description":"须能解析为大于零的 BigDecimal；可使用指数形式"},"currency":{"const":"CNY"}}},
    "artifactRef": {"type":"object","required":["seriesId","version"],"properties":{"seriesId":{"$ref":"#/$defs/id"},"revisionId":{"$ref":"#/$defs/id"},"version":{"type":"integer","minimum":1}}},
    "listingSourceRef": {"type":"object","required":["sourceRevision","contentHash"],"anyOf":[{"required":["sourceId"]},{"required":["id"]}],"description":"来源身份必须唯一并与候选成果中的版本和摘要一致；未提供 sourceSystem 时使用 legacy-local，id 是 sourceId 的兼容别名。dataMode 不参与输入校验。","properties":{"sourceSystem":{"type":"string","pattern":"^[a-z][a-z0-9.-]{0,95}$"},"sourceId":{"type":"string","minLength":1,"maxLength":255},"id":{"type":"string","minLength":1,"maxLength":255},"sourceRevision":{"type":"string","minLength":1,"maxLength":255},"contentHash":{"type":"string","pattern":"^[0-9a-f]{64}$"},"dataMode":{}}},
    "sourceRef": {"type":"object","required":["type","id"],"properties":{"type":{"type":"string"},"id":{"$ref":"#/$defs/id"},"label":{"type":"string"},"sourceSystem":{"type":"string","maxLength":64},"sourceRevision":{"type":"string","maxLength":255},"contentHash":{"type":"string","pattern":"^[0-9a-f]{64}$"},"dataMode":{"enum":["REAL","SIMULATED","MIXED","UNKNOWN"]},"fields":{"type":"array","items":{"type":"string"}}}},
    "context": {"type":["object","null"],"description":"输入时 context、refs 和 criteria 可以省略，context 或 criteria 为 null 时按空对象处理；输出包含 refs 和 criteria。","properties":{"refs":{"type":"array","maxItems":100,"items":{"$ref":"#/$defs/sourceRef"}},"criteria":{"type":["object","null"],"properties":{"region":{"type":["string","null"]},"areaCode":{"type":["string","null"]},"budget":{"oneOf":[{"$ref":"#/$defs/money"},{"type":"null"}]},"bedrooms":{"oneOf":[{"type":"integer","minimum":0,"maximum":30},{"type":"string","pattern":"^[+-]?[0-9]+$","description":"解析为整数后必须在 0 至 30 之间"},{"type":"null"}]},"platform":{"type":["string","null"]},"period":{"type":["string","null"]},"scopeLabel":{"type":["string","null"]},"requirements":{"type":["string","null"]}},"additionalProperties":false}},"additionalProperties":false},
    "command": {"type":"object","required":["requestId","actionId","expectedContextRevision"],"description":"load-context-listings 不要求 input 或 artifactRefs；compare 和 publish-plan 需要相应操作的输入。修订号也接受可解析为整数的字符串。","properties":{"requestId":{"$ref":"#/$defs/id"},"actionId":{"type":"string","minLength":1,"maxLength":160},"expectedContextRevision":{"oneOf":[{"type":"integer","minimum":1},{"type":"string","pattern":"^[+]?[0-9]+$"}]},"input":{"type":"object"},"artifactRefs":{"type":"array","items":{"$ref":"#/$defs/artifactRef"}}}},
    "listingComparisonInput": {"type":"object","anyOf":[{"required":["listingRefs"]},{"required":["listingIds","sourceVersions"]}],"description":"支持 listingRefs 和旧版 listingIds/sourceVersions；同一来源身份不可重复，版本与摘要必须匹配当前候选成果。","properties":{"listingRefs":{"type":"array","minItems":2,"maxItems":6,"items":{"$ref":"#/$defs/listingSourceRef"}},"listingIds":{"type":"array","minItems":2,"maxItems":6,"items":{"type":"string"}},"sourceVersions":{"type":"array","items":{"type":"object","required":["id"],"properties":{"id":{"type":"string"},"sourceRevision":{"type":"string"}}}}}},
    "receipt": {"type":"object","required":["requestId","workId","status"],"properties":{"requestId":{"$ref":"#/$defs/id"},"workId":{"$ref":"#/$defs/id"},"status":{"type":"string"},"artifactRefs":{"type":"array","items":{"$ref":"#/$defs/artifactRef"}},"run":{"type":"object"},"message":{"type":"string"}}},
    "artifact": {"type":"object","required":["seriesId","revisionId","version","workId","type","schemaVersion","title","content","contextRevision","sourceRefs","actions","freshness"],"properties":{"seriesId":{"$ref":"#/$defs/id"},"revisionId":{"$ref":"#/$defs/id"},"version":{"type":"integer","minimum":1},"workId":{"$ref":"#/$defs/id"},"sourceArtifactId":{"type":["string","null"]},"taskId":{"type":["string","null"]},"type":{"type":"string"},"schemaVersion":{"const":"1.0"},"title":{"type":"string"},"content":{"type":"object"},"contextRevision":{"type":"integer","minimum":1},"sourceRefs":{"type":"array","items":{"$ref":"#/$defs/sourceRef"}},"actions":{"type":"array","items":{"type":"object","required":["actionId","kind","label","availability"]}},"freshness":{"type":"object","required":["status","reasons"],"properties":{"status":{"enum":["CURRENT","STALE","UNKNOWN"]},"reasons":{"type":"array","items":{"type":"string"}}}},"createdAt":{"type":"string","format":"date-time"}}},
    "draftRevision": {"type":"object","required":["requestId","expectedVersion"],"properties":{"requestId":{"$ref":"#/$defs/id"},"expectedVersion":{"oneOf":[{"type":"integer","minimum":1},{"type":"string","pattern":"^[+]?[0-9]+$"}]},"content":{"type":"object","properties":{"body":{"type":"string","maxLength":100000},"headline":{"type":"string","description":"超过 500 字符的 headline 会被忽略"}}},"derivedFromVersion":{"oneOf":[{"type":"integer","minimum":1},{"type":"string","pattern":"^[+]?[0-9]+$"},{"type":"null"}]},"note":{"type":"string","description":"超过 500 字符时截断"}},"anyOf":[{"required":["derivedFromVersion"],"properties":{"derivedFromVersion":{"not":{"type":"null"}}}},{"required":["content"],"properties":{"content":{"required":["body"]}}}]}
  }
}
