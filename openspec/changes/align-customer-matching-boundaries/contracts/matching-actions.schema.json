{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bkanent:a2a:customer-matching:1.0",
  "title": "买方客户房源匹配动作载荷",
  "description": "共用 A2A 信封内的匹配载荷。预算上限、区域和明确房厅约束由服务端逐项校验，先输出完整符合软偏好的候选，再输出标明差异的放宽候选。需要补充或执行失败使用信封的等待或失败分支。",
  "oneOf": [
    {
      "$ref": "#/$defs/MatchRequest"
    },
    {
      "$ref": "#/$defs/Matched"
    },
    {
      "$ref": "#/$defs/NoMatch"
    }
  ],
  "x-actions": {
    "customer.listings.match": {
      "contractVersion": "1.0",
      "request": {
        "$ref": "#/$defs/MatchRequest"
      },
      "result": {
        "$ref": "#/$defs/MatchResult"
      }
    }
  },
  "$defs": {
    "Id": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,18}$"
    },
    "ListingRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sourceSystem": {
          "const": "legacy-local"
        },
        "sourceId": {
          "$ref": "#/$defs/Id"
        }
      },
      "required": [
        "sourceSystem",
        "sourceId"
      ]
    },
    "MatchRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "customerId": {
          "$ref": "#/$defs/Id"
        },
        "criteria": {
          "$ref": "#/$defs/EffectiveCriteria"
        }
      },
      "required": [
        "customerId"
      ]
    },
    "ListingSummary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        },
        "address": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        },
        "layout": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        },
        "areaSquareMetres": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,2})?$"
        },
        "askingPriceYuan": {
          "$ref": "#/$defs/PositiveDecimal"
        }
      },
      "required": [
        "title",
        "address",
        "layout",
        "areaSquareMetres",
        "askingPriceYuan"
      ]
    },
    "MatchItem": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "listingRef": {
          "$ref": "#/$defs/ListingRef"
        },
        "listingVersion": {
          "type": "string",
          "pattern": "^\\S{1,255}$"
        },
        "observedAt": {
          "type": "string",
          "format": "date-time"
        },
        "listingStatus": {
          "const": "ON_SALE"
        },
        "summary": {
          "$ref": "#/$defs/ListingSummary"
        },
        "matchReason": {
          "type": "string",
          "maxLength": 2000,
          "pattern": "\\S"
        },
        "matchScore": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "regionRef": {
          "type": "string",
          "maxLength": 256,
          "pattern": "\\S"
        },
        "layoutFacts": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "bedrooms": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "livingRooms": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            }
          },
          "required": []
        },
        "matchTier": {
          "enum": [
            "EXACT_PREFERENCES",
            "RELAXED_PREFERENCES"
          ]
        },
        "preferenceDifferences": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PreferenceDifference"
          }
        }
      },
      "required": [
        "listingRef",
        "listingVersion",
        "observedAt",
        "listingStatus",
        "summary",
        "matchReason",
        "regionRef",
        "matchTier",
        "preferenceDifferences"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "matchTier": {
                "const": "EXACT_PREFERENCES"
              }
            },
            "required": [
              "matchTier"
            ]
          },
          "then": {
            "properties": {
              "preferenceDifferences": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "matchTier": {
                "const": "RELAXED_PREFERENCES"
              }
            },
            "required": [
              "matchTier"
            ]
          },
          "then": {
            "properties": {
              "preferenceDifferences": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "Matched": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "customerId": {
          "$ref": "#/$defs/Id"
        },
        "demandHash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "observedAt": {
          "type": "string",
          "format": "date-time"
        },
        "outcome": {
          "const": "MATCHED"
        },
        "matches": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MatchItem"
          },
          "minItems": 1,
          "maxItems": 10
        },
        "effectiveCriteria": {
          "$ref": "#/$defs/EffectiveCriteria"
        }
      },
      "required": [
        "customerId",
        "demandHash",
        "observedAt",
        "outcome",
        "matches",
        "effectiveCriteria"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "effectiveCriteria": {
                "properties": {
                  "exactLayout": {
                    "required": [
                      "bedrooms"
                    ]
                  }
                },
                "required": [
                  "exactLayout"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "matches": {
                "items": {
                  "required": [
                    "layoutFacts"
                  ],
                  "properties": {
                    "layoutFacts": {
                      "required": [
                        "bedrooms"
                      ],
                      "properties": {
                        "bedrooms": {
                          "type": "integer"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "effectiveCriteria": {
                "properties": {
                  "exactLayout": {
                    "required": [
                      "livingRooms"
                    ]
                  }
                },
                "required": [
                  "exactLayout"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "matches": {
                "items": {
                  "required": [
                    "layoutFacts"
                  ],
                  "properties": {
                    "layoutFacts": {
                      "required": [
                        "livingRooms"
                      ],
                      "properties": {
                        "livingRooms": {
                          "type": "integer"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "NoMatch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "customerId": {
          "$ref": "#/$defs/Id"
        },
        "demandHash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "observedAt": {
          "type": "string",
          "format": "date-time"
        },
        "outcome": {
          "const": "NO_MATCH"
        },
        "matches": {
          "type": "array",
          "maxItems": 0
        },
        "reason": {
          "type": "string",
          "maxLength": 1000,
          "pattern": "\\S"
        },
        "effectiveCriteria": {
          "$ref": "#/$defs/EffectiveCriteria"
        }
      },
      "required": [
        "customerId",
        "demandHash",
        "observedAt",
        "outcome",
        "matches",
        "reason",
        "effectiveCriteria"
      ]
    },
    "MatchResult": {
      "oneOf": [
        {
          "$ref": "#/$defs/Matched"
        },
        {
          "$ref": "#/$defs/NoMatch"
        }
      ]
    },
    "PositiveDecimal": {
      "type": "string",
      "pattern": "^(?:[1-9][0-9]*(?:\\.[0-9]{1,2})?|0\\.(?:0[1-9]|[1-9][0-9]?))$"
    },
    "ExactLayout": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bedrooms": {
          "type": "integer",
          "minimum": 0
        },
        "livingRooms": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [],
      "anyOf": [
        {
          "required": [
            "bedrooms"
          ]
        },
        {
          "required": [
            "livingRooms"
          ]
        }
      ]
    },
    "PreferredArea": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "minimumSquareMetres": {
          "$ref": "#/$defs/PositiveDecimal"
        },
        "maximumSquareMetres": {
          "$ref": "#/$defs/PositiveDecimal"
        }
      },
      "required": [],
      "anyOf": [
        {
          "required": [
            "minimumSquareMetres"
          ]
        },
        {
          "required": [
            "maximumSquareMetres"
          ]
        }
      ]
    },
    "EffectiveCriteria": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "regionRefs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 256,
            "pattern": "\\S"
          }
        },
        "budgetUpperYuan": {
          "$ref": "#/$defs/PositiveDecimal"
        },
        "exactLayout": {
          "$ref": "#/$defs/ExactLayout"
        },
        "preferredLayout": {
          "type": "string",
          "maxLength": 256,
          "pattern": "\\S"
        },
        "preferredArea": {
          "$ref": "#/$defs/PreferredArea"
        },
        "provenanceRefs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 256,
            "pattern": "\\S"
          }
        }
      },
      "required": [
        "regionRefs",
        "budgetUpperYuan"
      ]
    },
    "PreferenceDifference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "field": {
          "enum": [
            "layout",
            "areaSquareMetres"
          ]
        },
        "preferred": {
          "type": "string",
          "maxLength": 256,
          "pattern": "\\S"
        },
        "actual": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        },
        "description": {
          "type": "string",
          "maxLength": 1000,
          "pattern": "\\S"
        }
      },
      "required": [
        "field",
        "preferred",
        "actual",
        "description"
      ]
    }
  }
}
